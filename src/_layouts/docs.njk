---
layout: base.njk
bodyClass: docs-page
---
<div class="docs-layout">

  <aside class="docs-sidebar">
    <nav class="docs-nav">

      <div class="docs-nav-group">
        <div class="docs-nav-group-label">For Developers</div>
        <ul class="docs-nav-list">
          {% for item in collections.devDocs %}
          <li><a href="{{ item.url }}" class="docs-nav-item{% if page.url == item.url %} active{% endif %}">{{ item.data.title }}</a></li>
          {% endfor %}
        </ul>
      </div>

      <div class="docs-nav-group">
        <div class="docs-nav-group-label">For Administrators</div>
        <ul class="docs-nav-list">
          {% for item in collections.adminDocs %}
          <li><a href="{{ item.url }}" class="docs-nav-item{% if page.url == item.url %} active{% endif %}">{{ item.data.title }}</a></li>
          {% endfor %}
        </ul>
      </div>

      <div class="docs-nav-group">
        <div class="docs-nav-group-label">For Players</div>
        <ul class="docs-nav-list">
          {% for item in collections.playerDocs %}
          <li><a href="{{ item.url }}" class="docs-nav-item{% if page.url == item.url %} active{% endif %}">{{ item.data.title }}</a></li>
          {% endfor %}
        </ul>
      </div>

    </nav>
  </aside>

  <main class="docs-main">
    <article class="docs-article active">
      <div class="docs-article-meta">{{ section_label }}</div>
      <h1>{{ title }}</h1>
      {{ content | safe }}
    </article>
  </main>

</div>
