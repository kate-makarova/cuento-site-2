---
layout: base.njk
bodyClass: docs-page
---
{% if locale == 'ru' %}
{% set devCollection = collections.ruDevDocs %}
{% set adminCollection = collections.ruAdminDocs %}
{% set playerCollection = collections.ruPlayerDocs %}
{% set labelDev = "Разработчикам" %}
{% set labelAdmin = "Администраторам" %}
{% set labelPlayer = "Игрокам" %}
{% else %}
{% set devCollection = collections.devDocs %}
{% set adminCollection = collections.adminDocs %}
{% set playerCollection = collections.playerDocs %}
{% set labelDev = "For Developers" %}
{% set labelAdmin = "For Administrators" %}
{% set labelPlayer = "For Players" %}
{% endif %}
<div class="docs-layout">

  <aside class="docs-sidebar">
    <nav class="docs-nav">

      {% if section == 'developers' %}
      <div class="docs-nav-group">
        <div class="docs-nav-group-label">{{ labelDev }}</div>
        <ul class="docs-nav-list">
          {% for item in devCollection %}
          <li><a href="{{ item.url | url }}" class="docs-nav-item{% if page.url == item.url %} active{% endif %}">{{ item.data.title }}</a></li>
          {% endfor %}
        </ul>
      </div>
      {% elif section == 'admins' %}
      <div class="docs-nav-group">
        <div class="docs-nav-group-label">{{ labelAdmin }}</div>
        <ul class="docs-nav-list">
          {% for item in adminCollection %}
          <li><a href="{{ item.url | url }}" class="docs-nav-item{% if page.url == item.url %} active{% endif %}">{{ item.data.title }}</a></li>
          {% endfor %}
        </ul>
      </div>
      {% elif section == 'players' %}
      <div class="docs-nav-group">
        <div class="docs-nav-group-label">{{ labelPlayer }}</div>
        <ul class="docs-nav-list">
          {% for item in playerCollection %}
          <li><a href="{{ item.url | url }}" class="docs-nav-item{% if page.url == item.url %} active{% endif %}">{{ item.data.title }}</a></li>
          {% endfor %}
        </ul>
      </div>
      {% endif %}

    </nav>
  </aside>

  <main class="docs-main">
    <article class="docs-article active">
      <div class="docs-article-meta">{{ section_label }}</div>
      <h1>{{ title }}</h1>
      {{ content | safe }}
    </article>
  </main>

</div>

<footer class="footer footer--slim">
  <div class="container footer-inner">
    <span class="footer-logo">Cuento</span>
    <a href="/llms.txt" class="footer-link footer-link--ai">For AI</a>
  </div>
</footer>
