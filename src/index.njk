  <script>
    (function () {
      const canvas = document.getElementById('constellation');
      if (!canvas) return;
      const ctx = canvas.getContext('2d');
      const N = 36, MAX_DIST = 110;
      const STAR_C = '210, 218, 226', LINE_C = '143, 168, 184';
      let W, H, particles = [];

      function resize() { W = canvas.width = canvas.offsetWidth; H = canvas.height = canvas.offsetHeight; }
      function makeParticle() { return { x: Math.random()*W, y: Math.random()*H, vx: (Math.random()-0.5)*0.22, vy: (Math.random()-0.5)*0.22, r: Math.random()*1.3+0.5 }; }
      function init() { resize(); particles = []; for (let i = 0; i < N; i++) particles.push(makeParticle()); }

      function tick() {
        ctx.clearRect(0, 0, W, H);
        ctx.beginPath(); ctx.arc(W/2, H/2, Math.min(W,H)/2-0.5, 0, Math.PI*2); ctx.fillStyle = '#0c0d0f'; ctx.fill();
        for (let i = 0; i < N; i++) {
          const p = particles[i];
          p.x += p.vx; p.y += p.vy;
          if (p.x < 0 || p.x > W) p.vx *= -1;
          if (p.y < 0 || p.y > H) p.vy *= -1;
          ctx.beginPath(); ctx.arc(p.x, p.y, p.r, 0, Math.PI*2); ctx.fillStyle = `rgba(${STAR_C},0.9)`; ctx.fill();
          for (let j = i+1; j < N; j++) {
            const q = particles[j], dx = p.x-q.x, dy = p.y-q.y, d = Math.sqrt(dx*dx+dy*dy);
            if (d < MAX_DIST) { ctx.beginPath(); ctx.moveTo(p.x,p.y); ctx.lineTo(q.x,q.y); ctx.strokeStyle=`rgba(${LINE_C},${(1-d/MAX_DIST)*0.38})`; ctx.lineWidth=0.6; ctx.stroke(); }
          }
        }
        requestAnimationFrame(tick);
      }
      init(); window.addEventListener('resize', init); tick();
    })();
  </script>
